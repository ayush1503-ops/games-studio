# Supabase browser configuration — copy this file to `.env.local` and fill in
# the values from your own Supabase project (Dashboard → Project Settings →
# API / Data API).
#
# The publishable (anon) key is safe to expose in a browser bundle. Never put a
# service_role or any other secret key in a VITE_ variable, and never commit a
# real key to Git.

# Project URL: always https://<project-ref>.supabase.co
# The project ref is the 20-character id in your Supabase dashboard URL.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Publishable / anon key for that project.
VITE_SUPABASE_ANON_KEY=your-publishable-key

# Optional. Only used to build "Open Supabase Auth" shortcut links in the admin
# console. Leave unset and the shortcut is hidden.
VITE_SUPABASE_PROJECT_REF=YOUR-PROJECT-REF
