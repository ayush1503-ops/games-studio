# =====================================================================
# Brainchild Games — Apache / cPanel configuration (ships inside `dist/`)
#
# This file is copied verbatim from `public/.htaccess` into the production
# build by Vite. Upload the *contents* of `dist/` (including this file —
# enable "Show Hidden Files" in the cPanel File Manager) to your domain's
# document root (usually `public_html`) and the site will run as-is.
# =====================================================================

# Don't list directory contents.
Options -Indexes

# Never serve environment / secret files if one is uploaded by accident.
<FilesMatch "^\.env">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- API shims -----------------------------------------------------
  # `/api/auth/*` routes exist only inside the `vite dev` server (see
  # `vite.config.ts`). On static cPanel hosting there is no Node process,
  # so answer 404 here instead of falling through to `index.html` — the
  # production bundle detects this and talks to Supabase directly.
  RewriteRule ^api/ - [R=404,L]

  # --- Single-page-app fallback --------------------------------------
  # This is a client-routed app: every deep link (`/admin`, `/admin/login`,
  # `/games`, ...) must serve `index.html` so React Router can take over.
  # Without this block, refreshing any page other than `/` gives an Apache
  # 404 — the most common "it works on Vercel but not on cPanel" symptom.
  #
  # NOTE: the substitution is a *relative* `index.html` (no leading slash)
  # so the same file also works when the site lives in a subdirectory
  # (e.g. `public_html/studio/`) instead of the document root.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# --- Caching -----------------------------------------------------------
# Vite fingerprints bundled files (`assets/index-ABC123.js`), so they are
# safe to cache forever. `index.html` itself must stay fresh, otherwise
# visitors keep booting an old bundle that references deleted filenames.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresDefault "access plus 1 month"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|ttf|eot|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# --- Security headers (mirrors `vercel.json`) ---------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=()"
  # Skip X-Frame-Options: it would break legitimate embeds the same way on
  # every host; enable it here only if you enable it in `vercel.json` too.
</IfModule>

# --- Compression --------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# --- Force HTTPS (optional) ---------------------------------------------
# Prefer the "Force HTTPS Redirect" toggle in cPanel (Domains > Settings) —
# it handles proxies/CDNs correctly. Only use the block below if that toggle
# is unavailable, and remove it again if you see redirect loops.
# <IfModule mod_rewrite.c>
#   RewriteCond %{HTTPS} off
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
# </IfModule>
