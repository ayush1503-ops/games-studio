# Production build values — baked into the bundle when `npm run build` runs.
#
# cPanel has no environment-variable dashboard like Vercel, so the ONLY way to
# configure the live site is to copy this file to `.env.production`, fill it
# in, and rebuild + re-upload `dist/` before every release:
#
#   cp .env.production.example .env.production
#   npm run build
#
# Find these in Supabase: Project Settings → API (project URL + publishable key).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key
VITE_SUPABASE_PROJECT_REF=YOUR-PROJECT-REF

# Optional: ONLY set this when the site is served from a subdirectory, e.g.
# `https://example.com/studio/` from `public_html/studio/`.
# Leading AND trailing slashes are required. Leave commented for domain-root
# installs (the normal cPanel case) and for Vercel.
# VITE_BASE_PATH=/studio/
